# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Comma-separated list of email addresses that receive tribute/photo notifications
TRIBUTE_TO=family@example.com

# SMTP credentials (AWS SES in production)
MAIL_HOST=email-smtp.us-east-2.amazonaws.com
MAIL_PORT=2587
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Miriam Ngo Memorial

# Optional overrides (defaults shown)
# PORT=3001
# SITE_URL=https://miriamngo.com
# DB_PATH=data/tributes.db
